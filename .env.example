SIM_TARGET_URL_TEMPLATE=http://receiver:9000/webhooks/{carrier}
SIM_CARRIERS=alpha,beta,gamma,delta,epsilon
SIM_RATE=5
SIM_SHIPMENTS_PER_BATCH=20
SIM_MAX_EVENTS=0
SIM_DUPLICATE_RATE=0.10
SIM_OUT_OF_ORDER_RATE=0.10
SIM_DUPLICATE_MAX_DELAY=5
SIM_SEED=12345
SIM_DRY_RUN=false
SIM_REQUEST_TIMEOUT=5
RECEIVER_HOST_PORT=9000

# Database target: leave empty for local SQLite, or paste your Supabase / Postgres URI
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Auto-cleanup retention in days: deletes events older than N days to prevent storage exhaustion
RECEIVER_RETENTION_DAYS=3
